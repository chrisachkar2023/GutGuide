# ─────────────────────────────────────────────────────────────────────
# Every variable here is optional.
#
# With none of them set, GutGuide runs on a seeded in-memory demo profile
# with 120 days of history — the whole app is interactive. Each key below
# upgrades one part of the experience.
# ─────────────────────────────────────────────────────────────────────

# Postgres / Tiger Data. Enables persistent logging.
# The log tables are promoted to TimescaleDB hypertables by `npm run db:setup`.
DATABASE_URL=

# Google Gemini. Enables menu photo reading and model-written explanations.
# Without it, explanations are generated locally from the same data.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs. Enables spoken guided cooking.
# Without it, guided cooking uses the browser's built-in speech synthesis.
ELEVENLABS_API_KEY=s

# Local environment overrides for GutGuide
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
